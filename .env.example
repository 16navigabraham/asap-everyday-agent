# --- Meta Muse Spark ---------------------------------------------------
# Meta Model API key. Every turn is answered by Muse Spark.
META_API_KEY=
META_MODEL=muse-spark-1.1
# low | medium | high. Muse Spark always reasons; "low" keeps replies fast
# and leaves token budget for the answer itself.
META_REASONING_EFFORT=low

# --- Channels ----------------------------------------------------------
PORT=3000
# Optional: also serve the agent on Telegram (token from @BotFather).
TELEGRAM_BOT_TOKEN=

# --- Sandbox -----------------------------------------------------------
# Demo credit each new chat starts with, in kobo. 1000000 = NGN 10,000.
STARTER_BALANCE_KOBO=1000000
QUOTE_TTL_MINUTES=10
SANDBOX_LATENCY_MS=1500
SANDBOX_RIDE_SECONDS=90

# Optional: WhatsApp through Meta's WhatsApp Cloud API. The channel turns on
# when all four are set. Webhook: https://<your-host>/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
