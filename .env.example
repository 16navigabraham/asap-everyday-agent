# Telegram: from @BotFather
TELEGRAM_BOT_TOKEN=

# VTpass: a key for THIS project, not a production key from elsewhere.
# Sign up at https://vtpass.com if you don't already have sandbox access.
VTPASS_BASE_URL=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

# Demo wallet (SQLite, this repo's own file, not a production database)
WALLET_DB_PATH=wallet.db
# Starting balance for a brand-new chat, in kobo. 500000 = NGN 5,000.
WALLET_SEED_KOBO=500000

# The model provider — Strands is model-agnostic (`agent.py`'s own
# `_build_model` picks between the two below), and the hackathon's own
# FAQ confirms eligibility never depended on Bedrock specifically: "Do
# you have to use Nova Pro or a specific model? No — use whatever model
# you want."
#
# Set ANTHROPIC_API_KEY to use Anthropic directly. Leave it unset to use
# Bedrock via the AWS credentials below instead — nothing else changes.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5

# AWS credentials for Bedrock, only read when ANTHROPIC_API_KEY above is
# unset. Set via `aws configure` or these env vars. See README for the
# Bedrock model-access step that has to be done once in the console
# before this will run on that path.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
