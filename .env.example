# --- Model -------------------------------------------------------------
# Meta Model API key. Muse Spark is the default model.
META_API_KEY=
META_MODEL=muse-spark-1.1
# low | medium | high. Muse Spark always reasons; "low" keeps replies fast
# and leaves token budget for the answer itself.
META_REASONING_EFFORT=low

# Optional. With both keys set, the web page can switch models live, and a
# failed Muse call fails over to Claude automatically (and vice versa).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Which model answers on boot: muse | claude
MODEL_PROVIDER=muse
# Set to false to disable automatic failover between providers.
MODEL_FAILOVER=true

# Required to flip the model switch from the web page. Leave empty to keep
# the switch read-only (recommended for a public deployment).
ADMIN_TOKEN=

# --- Channels ----------------------------------------------------------
PORT=3000
# Optional: also serve the agent on Telegram (token from @BotFather).
TELEGRAM_BOT_TOKEN=

# --- Sandbox -----------------------------------------------------------
# Demo credit each new chat starts with, in kobo. 500000 = NGN 5,000.
STARTER_BALANCE_KOBO=500000
QUOTE_TTL_MINUTES=10
SANDBOX_LATENCY_MS=1500
