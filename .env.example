# Telegram: from @BotFather
TELEGRAM_BOT_TOKEN=

# VTpass: a key for THIS project, not a production key from elsewhere.
# Sign up at https://vtpass.com if you don't already have sandbox access.
VTPASS_BASE_URL=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

# Demo wallet (SQLite, this repo's own file, not a production database)
WALLET_DB_PATH=wallet.db
# Starting balance for a brand-new chat, in kobo. 500000 = NGN 5,000.
WALLET_SEED_KOBO=500000

# AWS credentials for Bedrock (Strands' default model provider).
# Set via `aws configure` or these env vars. See README for the Bedrock
# model-access step that has to be done once in the console before this
# will run.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
